{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "podcasts",
        "lectures",
        "interviews"
      ]
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "url": {
      "type": "string"
    },
    "audio_file": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "kind"
  ]
}