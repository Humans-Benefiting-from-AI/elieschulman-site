{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "title_html": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "description_html": {
      "type": "string"
    },
    "eyebrow": {
      "type": "string"
    },
    "lede": {
      "type": "string"
    },
    "author": {
      "default": "Elie Schulman",
      "type": "string"
    },
    "meta": {
      "type": "string"
    },
    "coverImage": {
      "type": "string"
    },
    "back_link": {
      "type": "string"
    },
    "text_epub": {
      "type": "string"
    },
    "text_pdf": {
      "type": "string"
    },
    "audio_only": {
      "type": "string"
    },
    "video_face": {
      "type": "string"
    },
    "video_graphics": {
      "type": "string"
    },
    "section": {
      "default": "ebook",
      "type": "string",
      "enum": [
        "ebook",
        "weekly-torah",
        "knowing-project"
      ]
    },
    "order": {
      "type": "number"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description"
  ]
}