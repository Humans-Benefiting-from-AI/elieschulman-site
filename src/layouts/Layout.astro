---
import '../styles/tokens.css';
import { generatePersonSchema } from '../lib/schema';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  schema?: string;
}

// Listen (/audio/) stays out of the nav while those pages are still coming-soon placeholders.
const defaultOgImage = '/og-image.png';
const { title, description, ogImage = defaultOgImage, schema } = Astro.props;
const siteUrl = Astro.site || 'https://www.elieschulman.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const noindex = pathname === '/audio' || pathname.startsWith('/audio/');
const ogImageUrl = new URL(ogImage, siteUrl).href;
const usesDefaultOgImage = ogImage === defaultOgImage;
const personSchema = generatePersonSchema();
---

<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex">}
  <link rel="canonical" href={canonicalUrl}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:image" content={ogImageUrl}>
  {usesDefaultOgImage && (
    <>
      <meta property="og:image:type" content="image/png">
      <meta property="og:image:width" content="1200">
      <meta property="og:image:height" content="630">
    </>
  )}
  <meta property="og:image:alt" content={title}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImageUrl}>
  <meta name="theme-color" content="#0f1b2d">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Frank+Ruhl+Libre:wght@400;500;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/site.css">
  <!-- JSON-LD Schema Markup -->
  <script is:inline type="application/ld+json" set:html={personSchema}></script>
  {schema && <script is:inline type="application/ld+json" set:html={schema}></script>}

</head>
<body>
<a class="skip-link" href="#main-content">Skip to main content</a>
<nav class="site-nav" aria-label="Primary navigation">
  <a href="/" class="logo">Elie Schulman</a>
  <button class="hamburger" aria-label="Open navigation menu" aria-expanded="false" aria-controls="site-navigation" hidden>
    <span></span><span></span><span></span>
  </button>
  <div class="nav-links" id="site-navigation">
    <a href="/start-here/">Start here</a>
    <a href="/writing/" aria-current={Astro.url.pathname.startsWith('/writing') ? 'page' : undefined}>Essays</a>
    <a href="/weekly-torah/" aria-current={Astro.url.pathname.startsWith('/weekly-torah') ? 'page' : undefined}>Torah</a>
    <a href="/maimonides/" aria-current={Astro.url.pathname.startsWith('/maimonides') ? 'page' : undefined}>Maimonides</a>
    <a href="/books/" aria-current={Astro.url.pathname.startsWith('/books') || Astro.url.pathname.startsWith('/read') ? 'page' : undefined}>Books</a>
    <a href="/about/" aria-current={Astro.url.pathname.startsWith('/about') ? 'page' : undefined}>About</a>
    <a href="https://emesnewsletter.substack.com">Newsletter ↗</a>
  </div>
</nav>

<main id="main-content" tabindex="-1">
  <slot />
</main>

<footer>
  <div class="footer-links">
    <a href="https://emesnewsletter.substack.com">Substack</a>
    <a href="mailto:elie@cohortlearninglabs.org">Email</a>
    <a href="https://www.cohortlearninglabs.org/cohorts?utm_source=elieschulman&amp;utm_medium=website&amp;utm_campaign=related_work&amp;utm_content=footer">Cohort Learning Labs · Facilitated groups</a>
    <a href="https://www.yishhe.org/practice/motivation?utm_source=elieschulman&amp;utm_medium=website&amp;utm_campaign=related_work&amp;utm_content=footer">YishHeh · Before prayer</a>
  </div>
  <p>&copy; 2026 Elie Schulman</p>
</footer>

<script>
  const nav = document.querySelector<HTMLElement>('.site-nav');
  const button = document.querySelector<HTMLButtonElement>('.hamburger');
  const links = document.querySelector<HTMLElement>('#site-navigation');
  const mobile = window.matchMedia('(max-width: 960px)');

  function setOpen(open: boolean) {
    button?.setAttribute('aria-expanded', String(open));
    button?.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
    button?.classList.toggle('active', open);
    links?.classList.toggle('active', open);
  }

  if (nav && button && links) {
    nav.classList.add('nav-ready');
    button.hidden = false;
    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    links.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setOpen(false)));
    nav.addEventListener('keydown', event => {
      if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        button.focus();
      }
    });
    document.addEventListener('click', event => {
      if (event.target instanceof Node && !nav.contains(event.target)) setOpen(false);
    });
    nav.addEventListener('focusout', event => {
      if (event.relatedTarget instanceof Node && !nav.contains(event.relatedTarget)) setOpen(false);
    });
    mobile.addEventListener('change', () => setOpen(false));
  }
</script>

</body>
</html>

<style>
  .footer-links { flex-wrap: wrap; row-gap: .75rem; }
  .footer-links a { max-width: 100%; overflow-wrap: anywhere; min-height: 44px; display: inline-flex; align-items: center; }
</style>
