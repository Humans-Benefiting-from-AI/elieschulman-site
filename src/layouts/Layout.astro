---
import { generatePersonSchema } from '../lib/schema';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  schema?: string;
}

const { title, description, ogImage = '/og-image.svg', schema } = Astro.props;
const siteUrl = Astro.site || 'https://elieschulman.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL(ogImage, siteUrl).href;
const personSchema = generatePersonSchema();
---

<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalUrl}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:image" content={ogImageUrl}>
  <meta property="og:image:alt" content={title}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImageUrl}>
  <meta name="theme-color" content="#0f1b2d">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/site.css">
  <!-- JSON-LD Schema Markup -->
  <script type="application/ld+json" set:html={personSchema}></script>
  {schema && <script type="application/ld+json" set:html={schema}></script>}
  <style>
    /* Dropdown Navigation Styles */
    .nav-item {
      position: relative;
      display: inline-block;
    }
    
    /* Ensure the trigger link still looks normal */
    .nav-item > a {
      display: inline-block;
      padding-bottom: 1rem; /* Invisible hit area for hover */
      margin-bottom: -1rem;
    }

    .dropdown {
      position: absolute;
      top: 100%;
      left: 50%;
      transform: translateX(-50%);
      background: var(--deep-navy);
      min-width: 160px;
      box-shadow: 0 8px 16px rgba(0,0,0,0.3);
      border-radius: 4px;
      padding: 0.5rem 0;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.2s, visibility 0.2s;
      z-index: 100;
      border: 1px solid rgba(255,255,255,0.05);
      text-align: center;
    }

    /* Show dropdown on hover */
    .nav-item:hover .dropdown,
    .nav-item:focus-within .dropdown {
      opacity: 1;
      visibility: visible;
    }

    /* Dropdown links */
    .dropdown a {
      display: block;
      padding: 0.75rem 1.25rem;
      color: var(--warm-ivory) !important;
      font-size: 0.85rem !important;
      white-space: nowrap;
    }

    .dropdown a:hover {
      background: rgba(255,255,255,0.05);
      color: var(--gold) !important;
    }

    /* Hamburger Menu Button */
    .hamburger {
      display: none;
      flex-direction: column;
      gap: 5px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 0.5rem;
      margin-left: auto;
    }
    .hamburger span {
      width: 24px;
      height: 2px;
      background: var(--warm-ivory);
      transition: all 0.3s;
      display: block;
    }
    .hamburger.active span:nth-child(1) {
      transform: rotate(45deg) translate(8px, 8px);
    }
    .hamburger.active span:nth-child(2) {
      opacity: 0;
    }
    .hamburger.active span:nth-child(3) {
      transform: rotate(-45deg) translate(7px, -7px);
    }

    @media (max-width: 820px) {
      .site-nav {
        flex-wrap: wrap;
        padding: 0.5rem 1rem;
      }

      .hamburger {
        display: flex;
      }

      .nav-links {
        display: none;
        width: 100%;
        flex-direction: column;
        gap: 0.5rem;
        margin-top: 0.5rem;
        padding-top: 0.5rem;
        border-top: 1px solid rgba(255,255,255,0.1);
      }

      .nav-links.active {
        display: flex;
      }

      .nav-links a {
        padding: 0.6rem 0;
        font-size: 0.85rem !important;
      }

      .nav-item {
        display: flex;
        flex-direction: column;
        width: 100%;
      }

      .nav-item > a {
        padding: 0.6rem 0;
        padding-bottom: 0;
        margin-bottom: 0;
      }

      .dropdown {
        position: static;
        transform: none;
        background: transparent;
        box-shadow: none;
        border: none;
        opacity: 1;
        visibility: visible;
        display: none;
        flex-direction: column;
        padding-top: 0.3rem;
        padding-left: 1rem;
        gap: 0.3rem;
      }

      .nav-item.active .dropdown {
        display: flex;
      }

      .dropdown a {
        padding: 0.4rem 0;
        font-size: 0.78rem !important;
        color: rgba(245,240,232,0.7) !important;
      }

      .dropdown a:hover {
        color: var(--gold) !important;
        background: none;
      }
    }
  </style>
</head>
<body>
<a class="skip-link" href="#main-content">Skip to main content</a>
<nav class="site-nav" aria-label="Primary navigation">
  <a href="/" class="logo">Elie Schulman</a>
  <button class="hamburger" aria-label="Toggle navigation menu" aria-expanded="false">
    <span></span>
    <span></span>
    <span></span>
  </button>
  <div class="nav-links">

    <!-- WRITINGS DROPDOWN -->
    <div class="nav-item has-dropdown">
      <a href="/writing/" aria-current={Astro.url.pathname.startsWith('/writing') || Astro.url.pathname.startsWith('/weekly-torah') || Astro.url.pathname.startsWith('/maimonides') ? 'page' : undefined}>Writings</a>
      <div class="dropdown">
        <a href="/writing/">Essays & Articles</a>
        <a href="/weekly-torah/">Weekly Torah</a>
        <a href="/maimonides/">Maimonides</a>
      </div>
    </div>

    <!-- AUDIO/TALKS DROPDOWN -->
    <div class="nav-item has-dropdown">
      <a href="/audio/" aria-current={Astro.url.pathname.startsWith('/audio') ? 'page' : undefined}>Audio & Talks</a>
      <div class="dropdown">
        <a href="/audio/podcasts/">Podcasts</a>
        <a href="/audio/lectures/">Lectures</a>
        <a href="/audio/interviews/">Interviews</a>
      </div>
    </div>

    <!-- EBOOKS -->
    <a href="/books/" aria-current={Astro.url.pathname.startsWith('/books') ? 'page' : undefined}>eBooks</a>

    <!-- ABOUT & SUBSCRIBE -->
    <a href="/about/" aria-current={Astro.url.pathname.startsWith('/about') ? 'page' : undefined}>About</a>
    <a href="https://emesnewsletter.substack.com">Subscribe</a>

  </div>
</nav>

<main id="main-content">
  <slot />
</main>

<footer>
  <div class="footer-links">
    <a href="https://emesnewsletter.substack.com">Substack</a>
    <a href="mailto:elie@cohortlearninglabs.org">Email</a>
    <a href="https://www.cohortlearninglabs.org/">Cohort Learning Labs</a>
  </div>
  <p>&copy; 2026 Elie Schulman</p>
</footer>

<script>
  const nav = document.querySelector('.site-nav');
  const hamburger = document.querySelector('.hamburger');
  const navLinks = document.querySelector('.nav-links');
  const navItems = document.querySelectorAll('.nav-item.has-dropdown');

  // Scroll effect on navbar
  window.addEventListener('scroll', () => {
    if(nav) {
      nav.style.background = window.scrollY > 50
        ? 'rgba(15, 27, 45, 0.98)'
        : 'rgba(15, 27, 45, 0.95)';
    }
  });

  // Hamburger menu toggle
  hamburger?.addEventListener('click', () => {
    hamburger.classList.toggle('active');
    hamburger.setAttribute('aria-expanded', hamburger.classList.contains('active'));
    navLinks?.classList.toggle('active');
  });

  // Close menu when a link is clicked
  const navLinks_all = navLinks?.querySelectorAll('a');
  navLinks_all?.forEach(link => {
    link.addEventListener('click', () => {
      hamburger?.classList.remove('active');
      hamburger?.setAttribute('aria-expanded', 'false');
      navLinks?.classList.remove('active');
    });
  });

  // Dropdown toggle on mobile
  navItems.forEach(item => {
    const link = item.querySelector('a');
    link?.addEventListener('click', (e) => {
      if (window.innerWidth <= 820) {
        e.preventDefault();
        item.classList.toggle('active');
      }
    });
  });

  // Close dropdowns when clicking outside
  document.addEventListener('click', (e) => {
    if (!nav?.contains(e.target)) {
      navItems.forEach(item => item.classList.remove('active'));
    }
  });
</script>

</body>
</html>
