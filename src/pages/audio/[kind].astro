---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/SectionHeader.astro';

export function getStaticPaths() {
  return [
    { params: { kind: 'podcasts' }, props: { label: 'Podcasts', lede: 'Podcast appearances and conversations.' } },
    { params: { kind: 'lectures' }, props: { label: 'Lectures', lede: 'Recorded classes and talks.' } },
    { params: { kind: 'interviews' }, props: { label: 'Interviews', lede: 'Interviews and media appearances.' } },
  ];
}

const { kind } = Astro.params;
const { label, lede } = Astro.props;

const items = (await getCollection('audio', ({ data }) => data.kind === kind))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));
---

<Layout title={`${label} — Elie Schulman`} description={lede}>
  <SectionHeader eyebrow="Audio & Talks" title={label} lede={lede} />
  <div class="content">
    <p><a class="back-link" href="/audio/">← Audio & Talks</a></p>
    {items.length === 0 ? (
      <p class="note">No {label.toLowerCase()} published yet — new recordings will appear here. Subscribe on <a class="work-link" href="https://emesnewsletter.substack.com">Substack</a> to be notified.</p>
    ) : (
      items.map((item) => (
        <div class="resource-card">
          {item.data.date && <p class="eyebrow">{item.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>}
          <h3>{item.data.url ? <a href={item.data.url}>{item.data.title}</a> : item.data.title}</h3>
          <p>{item.data.description}</p>
          {item.data.audio_file && (
            <audio controls preload="none" src={item.data.audio_file} style="width: 100%;"></audio>
          )}
        </div>
      ))
    )}
  </div>
</Layout>
