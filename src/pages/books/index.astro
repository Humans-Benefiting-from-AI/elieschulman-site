---
import Layout from '../../layouts/Layout.astro';
import { getPublishedTeachings } from '../../lib/teachings';

const teachings = await getPublishedTeachings();
---

<Layout
  title="eBooks — Elie Schulman"
  description="Downloadable ebooks and PDFs."
>
<header class="page-header">
  <div class="page-header-inner">
    <p class="eyebrow">Library</p>
    <h1>eBooks</h1>
    <p class="lede">Free, downloadable books available in EPUB and PDF formats.</p>
  </div>
</header>

<div class="content">
  {teachings.length === 0 ? (
    <p class="note">No ebooks published yet.</p>
  ) : (
    <div class="featured-grid">
      {teachings.map((entry) => (
        <div class="featured-card">
          <h4>
            <a class="featured-link" href={`/books/${entry.id}/`}>
              {entry.data.title}
            </a>
          </h4>
          <p class="note" style="margin-top: 0.5rem;">{entry.data.description}</p>
        </div>
      ))}
    </div>
  )}
</div>
</Layout>
