---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="eBooks — Elie Schulman" 
  description="Downloadable ebooks and PDFs."
>
<header class="page-header">
  <div class="page-header-inner">
    <p class="eyebrow">Library</p>
    <h1>eBooks</h1>
    <p class="lede">Free, downloadable books available in EPUB and PDF formats.</p>
  </div>
</header>

<div class="content bookshelf-container">
  <div class="apple-bookshelf">
    
    <!-- Book 1 -->
    <a href="/books/vocabulary-pov/" class="apple-book">
      <!-- We use a gradient here as a placeholder until you add actual cover images -->
      <div class="book-cover" style="background: linear-gradient(135deg, #1a2744, #0f1b2d);">
        <span class="cover-title">Vocabulary of a particular human's first person point of view</span>
      </div>
      <div class="book-info">
        <h4 class="book-title">Vocabulary of a particular human's first person point of view</h4>
        <p class="book-author">Elie Schulman</p>
      </div>
    </a>

    <!-- Book 2 -->
    <a href="/books/shoftim/" class="apple-book">
      <div class="book-cover" style="background: linear-gradient(135deg, #c9a84c, #a88a3a);">
        <span class="cover-title">Shoftim</span>
      </div>
      <div class="book-info">
        <h4 class="book-title">Shoftim</h4>
        <p class="book-author">Elie Schulman</p>
      </div>
    </a>

  </div>
</div>
</Layout>

<style>
  .bookshelf-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  
  /* The Grid */
  .apple-bookshelf {
    display: grid;
    /* This automatically creates columns based on screen size! */
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 3rem 2rem;
    align-items: start;
  }

  .apple-book {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    outline: none;
  }

  /* The Book Cover */
  .book-cover {
    position: relative;
    width: 100%;
    /* Standard book ratio */
    aspect-ratio: 2 / 3;
    border-radius: 4px;
    
    /* Apple-style base shadow */
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15), 0 0 1px rgba(0,0,0,0.1);
    
    /* Smooth animation physics */
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    text-align: center;
    overflow: hidden;
  }

  /* Hover & Lift effect */
  .apple-book:hover .book-cover,
  .apple-book:focus-visible .book-cover {
    transform: translateY(-8px) scale(1.03);
    box-shadow: 0 16px 30px rgba(0, 0, 0, 0.2), 0 0 2px rgba(0,0,0,0.1);
  }
  
  /* Subtle lighting effect to mimic a physical book spine/glare */
  .book-cover::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(to right, rgba(255,255,255,0.25) 0%, rgba(255,255,255,0) 15%, rgba(0,0,0,0.1) 100%);
    pointer-events: none;
  }

  .cover-title {
    color: white;
    font-family: var(--serif);
    font-size: 1.1rem;
    line-height: 1.2;
    text-shadow: 0 1px 3px rgba(0,0,0,0.5);
  }

  /* Typography below the book */
  .book-info {
    margin-top: 1rem;
  }

  .book-title {
    font-family: var(--sans);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text-primary);
    margin-bottom: 0.2rem;
    
    /* Truncate to 2 lines if title is too long */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .book-author {
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--text-light);
    margin: 0;
  }
</style>
