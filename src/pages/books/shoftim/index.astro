---
import Layout from '../../../layouts/Layout.astro';
---

<Layout 
  title="Shoftim — Elie Schulman" 
  description="Weekly Torah Portion: Shoftim"
>
<header class="page-header">
  <div class="page-header-inner">
    <p class="eyebrow">Weekly Torah Portion</p>
    <h1>Shoftim</h1>
    <p class="lede">Judges and officers you shall appoint.</p>
  </div>
</header>

<section class="bg-cream" style="padding: 4rem 2rem; min-height: 50vh;">
  <div class="section-inner" style="max-width: 800px; margin: 0 auto;">
    <a class="back-link" href="/writing/">← Back to the Writing Map</a>
    <div class="book-card" style="margin-top: 2rem;">
      <div class="book-info">
        <h3>Shoftim</h3>
        <p class="book-author">Elie Schulman</p>
        <p class="book-meta">Weekly Parsha Series</p>
        <p class="book-desc">
          For WhatsApp, download the PDF — it's one 14-page file that opens inline on any phone. 
          The EPUB is for anyone who wants to read it in Kindle, Apple Books, or another reader app.
        </p>
        <div class="download-panel">
          <p>Download the ebook:</p>
          <a class="download-button" href="/books/shoftim/shoftim.epub" download>Download EPUB</a>
          <a class="download-button" href="/books/shoftim/shoftim.pdf" download style="background: transparent; color: var(--midnight); border: 1px solid rgba(15,27,45,0.25);">Download PDF</a>
          <p class="note" style="margin-top:0.6rem;margin-bottom:0;">Free. No email required.</p>
        </div>
      </div>
    </div>
  </div>
</section>
</Layout>
