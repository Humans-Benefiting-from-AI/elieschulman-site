---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Elie Schulman — Writer on Language, Judgment, and Learning" 
  description="Books, essays, and translations examining how words carry assumptions, how inherited categories guide judgment, and how people learn to see the structures shaping an argument, a relationship, or a group."
>
<section class="hero">
  <div class="hero-inner">
    <p class="eyebrow">Writer · Educator · Translator</p>
    <h1>Making the hidden structure of language, judgment, and learning visible.</h1>
    <p class="subtitle">
      Books, essays, and translations that examine how words carry assumptions,
      how inherited categories guide judgment, and how people learn to see the
      structures already organizing how they think and act.
    </p>
    <a href="/writing/" class="cta">Read the Essays</a>
    <a href="/books/vocabulary-pov/" class="cta-secondary">Read vocabulary of a particular human's first person point of view</a>
  </div>
</section>

<section class="bg-cream">
  <div class="section-inner">
    <p class="section-label">Writing & Torah</p>
    <h2 class="section-title">Essays and Parsha</h2>
    <p class="section-intro">
      Read essays on language, judgment, and group process, or dive into weekly Torah portion commentary.
    </p>
    <div class="category-preview" style="display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin-top: 2rem;">
      <a href="/writing/" style="text-decoration: none;">
        <div class="cat-label" style="background: white; padding: 1.5rem 2rem; border-radius: 4px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); color: var(--midnight);">
          <h3>General Writing →</h3>
        </div>
      </a>
      <a href="/weekly-torah/" style="text-decoration: none;">
        <div class="cat-label" style="background: white; padding: 1.5rem 2rem; border-radius: 4px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); color: var(--midnight);">
          <h3>Weekly Torah Portion →</h3>
        </div>
      </a>
    </div>
  </div>
</section>

<section class="bg-white">
  <div class="section-inner">
    <p class="section-label">Maimonides Library</p>
    <h2 class="section-title">A writing project organized around Rambam's words</h2>
    <p class="section-intro">
      Books and manuscripts, twenty-two completed ebook volumes on Yesodei HaTorah,
      a Mada series of Ibn Tibbon reframings, and standalone essays — each taking a
      single question from Maimonides and following it for different audiences.
    </p>
    <div class="featured-grid">
      <div class="featured-card">
        <h4>Books &amp; Manuscripts</h4>
        <p class="note">Emes in development; Everything Changes published; Davar in progress</p>
        <p><a class="featured-link" href="/maimonides/books/">View books →</a></p>
      </div>
      <div class="featured-card">
        <h4>22 Ebook Volumes</h4>
        <p class="note">Yesodei HaTorah 1:1–1:12 and 2:1–2:10</p>
        <p><a class="featured-link" href="/maimonides/foundations/">View volumes →</a></p>
      </div>
      <div class="featured-card">
        <h4>Standalone Essays</h4>
        <p class="note">Abraham, dialogue, language, attributes</p>
        <p><a class="featured-link" href="/maimonides/essays/">View essays →</a></p>
      </div>
    </div>
  </div>
</section>
</Layout>
