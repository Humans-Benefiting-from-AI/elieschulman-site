---
import {
  getPublishedTeachings,
  teachingsWithEpub,
  teachingCoverUrl,
} from '../../lib/teachings';

export async function getStaticPaths() {
  const published = await getPublishedTeachings();
  return teachingsWithEpub(published).map((entry) => ({
    params: { book: entry.id },
    props: {
      title: entry.data.title,
      coverImage: teachingCoverUrl(entry),
      epubPath: entry.data.text_epub as string,
    },
  }));
}

const { book } = Astro.params;
const { title, coverImage, epubPath } = Astro.props;
const canonicalUrl = `https://www.elieschulman.com/read/${book}/`;
const ogImage = coverImage
  ? `https://www.elieschulman.com${coverImage}`
  : `https://www.elieschulman.com/books/${book}/cover.png`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — Reader</title>
  <meta name="description" content={`Read ${title} by Elie Schulman online — free, Kindle-style reading in your browser.`} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={`${title} — Elie Schulman`} />
  <meta property="og:description" content={`Read ${title} free online — no app needed. Kindle-style reading in your browser.`} />
  <meta property="og:type" content="book" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={`Cover of ${title}`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />
  <meta name="theme-color" content="#f3efe6" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #fdfbf7; --fg: #1c1c1c; --chrome: #f3efe6; --accent: #7a5c2e;
    }
    [data-theme="dark"] { --bg: #141414; --fg: #e8e6e3; --chrome: #1f1f1f; --accent: #d3b97c; }
    [data-theme="sepia"] { --bg: #f6f0e3; --fg: #3d3225; --chrome: #efe6d2; --accent: #8a6d3b; }
    * { box-sizing: border-box; }
    .reader-skip { position: fixed; top: 0; left: 1rem; z-index: 100; padding: .6rem 1rem;
                   background: var(--fg); color: var(--bg); transform: translateY(-120%); }
    .reader-skip:focus { transform: translateY(0); }
    body { margin: 0; background: var(--bg); color: var(--fg);
           font-family: Georgia, 'Times New Roman', serif;
           display: flex; flex-direction: column; height: 100dvh;
           overscroll-behavior: none; touch-action: pan-y;
           -webkit-tap-highlight-color: transparent; }
    html { touch-action: manipulation; }
    header, footer { transition: transform .25s ease, opacity .25s ease; z-index: 10; }
    body.chrome-hidden header { transform: translateY(-100%); opacity: 0; pointer-events: none; }
    body.chrome-hidden footer { transform: translateY(100%); opacity: 0; pointer-events: none; }
    /* TOC drawer. Chapter links are created in script, so their rules use :global
       — Astro's scoped attribute is not copied onto those elements. */
    #toc-drawer { position: fixed; top: 0; left: 0; bottom: 0; width: min(320px, 85vw); z-index: 30;
                  background: #faf7f2; color: #0f1b2d;
                  font-family: Inter, -apple-system, sans-serif;
                  transform: translateX(-105%); transition: transform .25s ease;
                  overflow-y: auto; padding: 1rem 0.75rem; box-shadow: 2px 0 12px rgba(0,0,0,.2); }
    #toc-drawer.open { transform: translateX(0); }
    #toc-drawer h2 { font-family: "Cormorant Garamond", Georgia, serif; font-size: 1.45rem;
                     font-weight: 600; line-height: 1.2; color: #0f1b2d; margin: 0 0.5rem 0.75rem; }
    #toc-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
    #toc-drawer :global(li) { display: block; margin: 0; }
    #toc-drawer :global(a) { display: flex; align-items: center; min-height: 44px;
                             padding: 0.5rem 0.75rem; color: #0f1b2d; text-decoration: none;
                             font-family: Inter, -apple-system, sans-serif; font-size: 0.95rem;
                             font-weight: 400; line-height: 1.35; border-radius: 6px; }
    #toc-drawer :global(a[data-depth="1"]) { padding-left: 1.5rem; }
    #toc-drawer :global(a[data-depth="2"]) { padding-left: 2.25rem; }
    #toc-drawer :global(a:hover),
    #toc-drawer :global(a[aria-current="location"]) { color: #7a6224; }
    #toc-drawer :global(a[aria-current="location"]) { background: rgba(122, 98, 36, 0.12); font-weight: 600; }
    #toc-drawer :global(a:focus-visible) { outline: 3px solid #7a6224; outline-offset: -3px; }
    #toc-scrim { position: fixed; inset: 0; z-index: 25; background: rgba(0,0,0,.35);
                 opacity: 0; pointer-events: none; transition: opacity .25s ease; }
    #toc-scrim.show { opacity: 1; pointer-events: auto; }
    header { display: flex; align-items: center; gap: .75rem; padding: .5rem 1rem;
             background: var(--chrome); font-family: system-ui, sans-serif; flex-wrap: wrap; }
    header h1 { font-size: 1rem; margin: 0; font-weight: 600; flex: 1; }
    header a { color: var(--accent); text-decoration: none; font-size: .9rem; }
    .controls { display: flex; gap: .4rem; align-items: center; }
    button, select { font: inherit; font-size: .85rem; padding: .3rem .6rem; border-radius: 6px;
                     border: 1px solid color-mix(in srgb, var(--fg) 25%, transparent);
                     background: transparent; color: var(--fg); cursor: pointer; }
    button:hover { background: color-mix(in srgb, var(--fg) 8%, transparent); }
    .share-btn { font-size: .85rem; padding: .3rem .6rem; border-radius: 6px;
                 border: 1px solid color-mix(in srgb, var(--fg) 25%, transparent);
                 color: var(--fg); text-decoration: none; }
    .share-btn:hover { background: color-mix(in srgb, var(--fg) 8%, transparent); }
    main { flex: 1; min-height: 0; }
    #viewer { width: 100%; height: 100%; }
    footer { display: flex; align-items: center; gap: 1rem; padding: .5rem 1rem;
             background: var(--chrome); font-family: system-ui, sans-serif; font-size: .8rem; }
    #progress { flex: 1; height: 4px; background: color-mix(in srgb, var(--fg) 15%, transparent);
                border-radius: 2px; cursor: pointer; }
    #progress > div { height: 100%; width: 0; background: var(--accent); border-radius: 2px; }
    .navzone { position: fixed; top: 15%; bottom: 15%; width: 18%; z-index: 5; cursor: pointer; }
    #prev-zone { left: 0; } #next-zone { right: 0; }
  </style>
</head>
<body data-book={book} data-epub={epubPath}>
  <a class="reader-skip" href="#reader-main">Skip to main content</a>
  <header>
    <a href="/books">← Library</a>
    <button id="toc-btn" title="Table of contents" aria-label="Open table of contents" aria-expanded="false" aria-controls="toc-drawer">☰</button>
    <h1>{title}</h1>
    <div class="controls">
      <a id="wa-share" class="share-btn" title="Share via WhatsApp" target="_blank" rel="noopener">Share</a>
      <button id="font-down" title="Smaller text">A−</button>
      <button id="font-up" title="Larger text">A+</button>
      <select id="theme" title="Theme">
        <option value="light">Light</option>
        <option value="sepia">Sepia</option>
        <option value="dark">Dark</option>
      </select>
    </div>
  </header>

  <main id="reader-main" tabindex="-1">
    <div id="viewer"></div>
  </main>
  <div id="prev-zone" class="navzone" title="Previous page"></div>
  <div id="next-zone" class="navzone" title="Next page"></div>
  <div id="toc-scrim"></div>
  <nav id="toc-drawer" aria-label="Table of contents" aria-hidden="true" tabindex="-1" inert>
    <h2 id="toc-heading">Contents</h2>
    <ol id="toc-list"></ol>
  </nav>

  <footer>
    <button id="prev">‹ Prev</button>
    <div id="progress"><div></div></div>
    <span id="loc" aria-live="polite"></span>
    <button id="next">Next ›</button>
  </footer>

  <script>
    import ePub from 'epubjs';

    const bookSlug = document.body.dataset.book;
    const storeKey = `reader:${bookSlug}`;
    const prefsKey = `reader:prefs`;

    function readStoredJson<T>(key: string, fallback: T): T {
      try {
        const value = localStorage.getItem(key);
        return value ? JSON.parse(value) : fallback;
      } catch {
        return fallback;
      }
    }

    function writeStoredJson(key: string, value: unknown) {
      try {
        localStorage.setItem(key, JSON.stringify(value));
      } catch {
        // Reading still works when storage is unavailable or full.
      }
    }

    const prefs = readStoredJson<Record<string, unknown>>(prefsKey, {});
    let fontSize = typeof prefs.fontSize === 'number' ? prefs.fontSize : 100;
    type ReaderTheme = 'light' | 'sepia' | 'dark';
    const storedTheme = typeof prefs.theme === 'string' ? prefs.theme : '';
    let theme: ReaderTheme = ['light', 'sepia', 'dark'].includes(storedTheme) ? storedTheme as ReaderTheme : 'light';

    const themeSelect = document.getElementById('theme') as HTMLSelectElement;
    themeSelect.value = theme;
    document.documentElement.dataset.theme = theme;

    const epubUrl = document.body.dataset.epub || `/books/${bookSlug}/${bookSlug}.epub`;
    const book = ePub(epubUrl);
    const rendition = book.renderTo('viewer', {
      width: '100%', height: '100%', flow: 'paginated', spread: 'auto',
    });

    function applyPrefs() {
      rendition.themes.override('font-size', fontSize + '%');
      const colors = {
        light: { bg: '#fdfbf7', fg: '#1c1c1c' },
        sepia: { bg: '#f6f0e3', fg: '#3d3225' },
        dark:  { bg: '#141414', fg: '#e8e6e3' },
      }[theme];
      rendition.themes.override('color', colors.fg);
      rendition.themes.override('background', colors.bg);
      document.documentElement.dataset.theme = theme;
      writeStoredJson(prefsKey, { fontSize, theme });
    }
    applyPrefs();

    const bookTitle = document.querySelector('h1')!.textContent?.trim() || 'Book';

    function clampPercent(value: number) {
      if (!Number.isFinite(value)) return 0;
      return Math.min(100, Math.max(0, Math.round(value)));
    }

    // epub.js only fills location.percentage after book.locations.generate().
    // Page turns still report a spine index and a page within that section, which
    // is enough to move the readout on next, previous, contents jumps, and resume.
    function readingPercent(loc: any) {
      if (!loc?.start) return 0;
      if (loc.atEnd) return 100;
      const sections = Number((book.spine as unknown as { length?: number }).length);
      if (!Number.isFinite(sections) || sections < 1) return 0;
      const index = Number.isFinite(loc.start.index) ? Number(loc.start.index) : 0;
      const page = Number(loc.start.displayed?.page) || 1;
      const pages = Math.max(1, Number(loc.start.displayed?.total) || 1);
      if (index >= sections - 1 && page >= pages) return 100;
      const intoSection = Math.min(1, Math.max(0, (page - 1) / pages));
      return clampPercent(((index + intoSection) / sections) * 100);
    }

    function applyProgress(loc: any) {
      const pct = readingPercent(loc);
      const bar = document.querySelector('#progress > div') as HTMLElement | null;
      const label = document.getElementById('loc');
      if (bar) bar.style.width = pct + '%';
      if (label) label.textContent = pct + '%';
    }

    function labelReaderFrame(view?: { iframe?: HTMLIFrameElement }) {
      const frameTitle = `${bookTitle} — book text`;
      const frames = new Set<HTMLIFrameElement>();
      if (view?.iframe) frames.add(view.iframe);
      document.querySelectorAll('#viewer iframe').forEach((node) => frames.add(node as HTMLIFrameElement));
      frames.forEach((frame) => { frame.title = frameTitle; });
    }

    // ── Table of contents drawer ───────────────────────────────────
    const drawer = document.getElementById('toc-drawer')!;
    const tocList = document.getElementById('toc-list')!;
    const scrim = document.getElementById('toc-scrim')!;
    const tocButton = document.getElementById('toc-btn')!;
    let activeHref = '';

    function chapterFile(href: string) {
      const path = href.split('#')[0];
      const file = path.split('/').filter(Boolean).pop() || path;
      try { return decodeURIComponent(file); } catch { return file; }
    }

    function markCurrentChapter(href: string) {
      if (href) activeHref = href;
      const file = chapterFile(activeHref);
      const hash = activeHref.includes('#') ? activeHref.split('#')[1] : '';
      const links = [...tocList.querySelectorAll('a')] as HTMLAnchorElement[];
      let current = links.find((link) => file && chapterFile(link.dataset.href || '') === file) || null;
      if (hash) {
        const hashed = links.find((link) => (link.dataset.href || '').split('#')[1] === hash);
        if (hashed) current = hashed;
      }
      links.forEach((link) => {
        if (link === current) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    }

    const closeToc = (restoreFocus = false) => {
      drawer.classList.remove('open');
      scrim.classList.remove('show');
      drawer.setAttribute('aria-hidden', 'true');
      drawer.inert = true;
      tocButton.setAttribute('aria-expanded', 'false');
      tocButton.setAttribute('aria-label', 'Open table of contents');
      if (restoreFocus) tocButton.focus();
    };
    const openToc = () => {
      drawer.classList.add('open');
      scrim.classList.add('show');
      drawer.setAttribute('aria-hidden', 'false');
      drawer.inert = false;
      tocButton.setAttribute('aria-expanded', 'true');
      tocButton.setAttribute('aria-label', 'Close table of contents');
      (tocList.querySelector('a') || drawer).focus();
    };
    tocButton.onclick = () => drawer.classList.contains('open') ? closeToc(true) : openToc();
    scrim.onclick = () => closeToc(true);

    type TocItem = { label?: string; href?: string; subitems?: TocItem[] };
    function addTocItems(items: TocItem[], depth = 0) {
      items.forEach((item) => {
        const label = (item.label || '').replace(/\s+/g, ' ').trim();
        if (label && item.href) {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.textContent = label;
          a.href = '#';
          a.dataset.href = item.href;
          if (depth) a.dataset.depth = String(Math.min(depth, 2));
          a.addEventListener('click', (e) => {
            e.preventDefault();
            rendition.display(item.href);
            closeToc();
          });
          li.appendChild(a);
          tocList.appendChild(li);
        }
        if (item.subitems?.length) addTocItems(item.subitems, depth + 1);
      });
    }

    book.loaded.navigation.then((nav: { toc?: TocItem[] }) => {
      addTocItems(nav.toc || []);
      markCurrentChapter(activeHref);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.classList.contains('open')) closeToc(true);
    });

    rendition.on('rendered', (_section: unknown, view: { iframe?: HTMLIFrameElement }) => {
      labelReaderFrame(view);
    });

    rendition.on('relocated', (loc: any) => {
      if (loc?.start?.cfi) writeStoredJson(storeKey, { cfi: loc.start.cfi });
      applyProgress(loc);
      if (loc?.start?.href) markCurrentChapter(loc.start.href);
    });

    // Restore last reading position after the progress and frame listeners exist.
    const saved = readStoredJson<{ cfi?: string } | null>(storeKey, null);
    rendition.display(saved?.cfi || undefined);

    const next = () => rendition.next();
    const prev = () => rendition.prev();
    document.getElementById('next')!.onclick = next;
    document.getElementById('prev')!.onclick = prev;
    document.getElementById('next-zone')!.onclick = next;
    document.getElementById('prev-zone')!.onclick = prev;

    // ── WhatsApp share ─────────────────────────────────────────────
    const shareUrl = `https://www.elieschulman.com/read/${bookSlug}/`;
    document.getElementById('wa-share')!.setAttribute('href',
      `https://wa.me/?text=${encodeURIComponent(`Reading "${bookTitle}" by Elie Schulman — free online:\n${shareUrl}`)}`);

    // ── Auto-hiding chrome (tap center to toggle) ──────────────────
    let chromeHidden = false;
    let hideTimer: number | undefined;
    function showChrome() {
      document.body.classList.remove('chrome-hidden');
      chromeHidden = false;
      clearTimeout(hideTimer);
      hideTimer = window.setTimeout(hideChrome, 4000);
    }
    function hideChrome() {
      document.body.classList.add('chrome-hidden');
      chromeHidden = true;
    }
    // Toggle on center-tap inside the book iframe
    (rendition as any).on('click', (e: MouseEvent) => {
      const w = window.innerWidth;
      if (e.clientX > w * 0.18 && e.clientX < w * 0.82) {
        chromeHidden ? showChrome() : hideChrome();
      }
    });
    rendition.on('relocated', showChrome);
    showChrome();

    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') next();
      if (e.key === 'ArrowLeft') prev();
    });
    (rendition as any).on('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowRight') next();
      if (e.key === 'ArrowLeft') prev();
    });

    let touchX: number | null = null;
    (rendition as any).on('touchstart', (e: TouchEvent) => { touchX = e.changedTouches[0].clientX; });
    (rendition as any).on('touchend', (e: TouchEvent) => {
      if (touchX === null) return;
      const dx = e.changedTouches[0].clientX - touchX;
      if (dx < -40) next(); else if (dx > 40) prev();
      touchX = null;
    });

    document.getElementById('font-up')!.onclick = () => { fontSize = Math.min(200, fontSize + 10); applyPrefs(); };
    document.getElementById('font-down')!.onclick = () => { fontSize = Math.max(60, fontSize - 10); applyPrefs(); };
    themeSelect.onchange = () => { theme = themeSelect.value as ReaderTheme; applyPrefs(); };
  </script>
</body>
</html>
