---
import Layout from '../../layouts/Layout.astro';
import {
  getPublishedTeachings,
  teachingsInSection,
} from '../../lib/teachings';

const weekly = teachingsInSection(await getPublishedTeachings(), 'weekly-torah');
---

<Layout
  title="Weekly Torah Portion — Elie Schulman"
  description="Writings and ebooks on the weekly parsha."
>
<header class="page-header">
  <div class="page-header-inner">
    <p class="eyebrow">Parsha</p>
    <h1>Weekly Torah Portion</h1>
    <p class="lede">Essays, ebooks, and commentary on the weekly parsha.</p>
  </div>
</header>

<div class="content">
  {weekly.length === 0 ? (
    <p class="note">Parsha teachings will appear here as they are published.</p>
  ) : (
    <div class="featured-grid">
      {weekly.map((entry) => (
        <div class="featured-card">
          <h4>
            <a class="featured-link" href={`/books/${entry.id}/`}>
              {entry.data.title}
            </a>
          </h4>
          <p class="note" style="margin-top: 0.5rem;">{entry.data.description}</p>
        </div>
      ))}
    </div>
  )}
</div>
</Layout>
