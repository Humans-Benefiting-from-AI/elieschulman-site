---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ResourceCard from '../../components/ResourceCard.astro';

const essays = (await getCollection('essays'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<Layout
  title="Writing — Elie Schulman"
  description="Essays on language, judgment, and learning."
>
  <SectionHeader
    eyebrow="Essays & Articles"
    title="Writing"
    lede="Essays examining how words carry assumptions, how inherited categories guide judgment, and how people learn to see the structures organizing how they think and act."
    accent="writing"
  />

  <div class="content">
    <div class="featured-grid">
      {essays.map((essay) => (
        <ResourceCard
          href={`/writing/${essay.id}/`}
          title={essay.data.title}
          note={essay.data.description || essay.data.lede}
        />
      ))}
    </div>
  </div>
</Layout>
